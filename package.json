{
  "name": "render-keeper",
  "version": "1.0.0",
  "private": true,
  "description": "Keeps a Render free-tier backend awake during a configurable time window, with an optional sync call",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "tick": "node --env-file=.env bin/keeper.mjs",
    "loop": "node --env-file=.env bin/keeper.mjs --loop",
    "dry-run": "node --env-file=.env bin/keeper.mjs --dry-run",
    "dev": "npx wrangler@4 dev --test-scheduled",
    "deploy": "npx wrangler@4 deploy"
  }
}

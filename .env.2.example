# Second keeper instance: wake-up pings only (no sync).
# Copy to .env.2 (git-ignored) and adjust.
BACKEND_URL=https://<your-other-app>.onrender.com
HEALTH_PATH=/health
# no SYNC_SECRET -> wake-up pings only
SYNC_SECRET=
SYNC_EVERY_MIN=0
# ping interval in minutes (Render free sleeps after 15 min idle -> keep it < 15)
TICK_MIN=10
# when to keep it awake (TIMEZONE local time, end exclusive); 00:00-24:00 = around the clock
TIMEZONE=Europe/Kyiv
ACTIVE_HOURS=08:00-22:00
ACTIVE_DAYS=1-7
